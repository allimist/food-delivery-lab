# Optional overrides for docker-compose.yml (copy to .env).
# How much faster than real life the lab runs (20 = a 15-minute prep takes 45 seconds).
TIME_SCALE=20
# Real seconds an accepted order waits for a courier before it is cancelled and refunded.
DISPATCH_TIMEOUT_S=90
# Redis memory cap (writes fail instead of the VM running out of memory).
REDIS_MAXMEMORY=200mb
